# MAPS_API_KEY: Required for VYBMapsPanel & LiveLocationChatMapSheet (Google Maps SDK for Android).
# Configure this value in the Secrets panel in AI Studio (and GitHub Secrets for CI builds).
MAPS_API_KEY=MY_MAPS_API_KEY

# FIREBASE_APPCHECK_DEBUG_TOKEN: Registered Firebase App Check debug token UUID for CI debug APKs.
FIREBASE_APPCHECK_DEBUG_TOKEN=

# RECAPTCHA_SITE_KEY: Optional override for release App Check reCAPTCHA Enterprise key.
RECAPTCHA_SITE_KEY=
